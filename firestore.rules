rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isParticipant(userIds) {
      return isSignedIn() && (request.auth.uid in userIds);
    }

    // Admin = custom claim, admins/{uid} doc, users/{uid}.role == 'admin',
    // or (TEMPORARY legacy fallback) designated admin email.
    // TODO: remove the email fallback once the admin claim / admins doc is set.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin') ||
        request.auth.token.get('email', '') in ['admin@wheelhomes.com', 'admin@wheelofcomfort.com']
      );
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    function isApprovedProvider() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'service_provider' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'approved';
    }

    // Field-diff helpers (for update rules)
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function noneChanged(keys) {
      return !changedKeys().hasAny(keys);
    }
    function onlyChanged(keys) {
      return changedKeys().hasOnly(keys);
    }

    // Fields no non-admin may modify on a job document after creation.
    // Escrow and payment state can ONLY be transitioned by Cloud Functions (Admin SDK) or Admins.
    function jobIdentityLocked() {
      return noneChanged([
        'clientId', 'userId', 'createdAt',
        'paymentStatus', 'escrowReference', 'escrowAmount',
        'escrowTransactionId', 'escrowSecuredAt', 'paymentReleasedAt'
      ]);
    }

    // The owning client of a job (supports both schemas)
    function isJobOwner(data) {
      return data.get('clientId', '') == request.auth.uid || data.get('userId', '') == request.auth.uid;
    }

    // Shared update logic for job_requests and requests
    function canUpdateJob(data) {
      return isSignedIn() && (
        isAdmin() ||
        // Client may update their own job details but cannot re-parent or alter escrow status
        (isJobOwner(data) && jobIdentityLocked()) ||
        // Assigned provider: cannot re-assign, re-price, or touch payment/escrow fields
        (data.get('providerId', '') == request.auth.uid &&
          noneChanged([
            'clientId', 'userId', 'createdAt', 'providerId',
            'price', 'budget',
            'paymentStatus', 'escrowReference', 'escrowAmount',
            'escrowTransactionId', 'escrowSecuredAt', 'paymentReleasedAt'
          ])) ||
        // Approved provider claiming an open/pending job for THEMSELVES only
        (data.get('status', '') in ['open', 'pending'] &&
          isApprovedProvider() &&
          onlyChanged(['status', 'providerId', 'acceptedAt', 'assignedAt', 'updatedAt',
                       'providerName', 'providerPhone', 'providerPhoto']) &&
          request.resource.data.get('providerId', '') == request.auth.uid &&
          request.resource.data.get('status', '') == 'accepted')
      );
    }

    // ------------------------------------------------------------------
    // CHATS
    // ------------------------------------------------------------------
    match /chats/{chatId} {
      allow read: if isParticipant(resource.data.participants) || isAdmin();

      allow create: if isSignedIn()
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() <= 10
                    && request.resource.data.participants.hasAll([request.auth.uid])
                    && request.resource.data.keys().hasAll(['participants', 'createdAt', 'updatedAt']);

      // Participants may update (e.g. lastMessage) but can never alter who is in the chat
      allow update: if isParticipant(resource.data.participants)
                    && noneChanged(['participants']);

      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data.participants) || isAdmin();

        allow create: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() < 2000;
        // Messages are immutable
        allow update, delete: if isAdmin();
      }
    }

    // ------------------------------------------------------------------
    // USER APPLICATIONS (Admin panel review queue)
    // ------------------------------------------------------------------
    match /user_applications/{appId} {
      allow read, write: if isAdmin();
      // Must be signed in to submit an application (no anonymous spam)
      allow create: if isSignedIn();
    }

    // ------------------------------------------------------------------
    // NOTIFICATIONS
    // ------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('recipientId', '') == request.auth.uid ||
        resource.data.get('recipientId', '') == 'all' ||
        isAdmin()
      );

      // Clients notify counterparties (e.g. job accepted). Broadcast ('all'/'admin')
      // notifications are admin-only so users can't spoof platform announcements.
      allow create: if isSignedIn()
                    && !(request.resource.data.get('recipientId', '') in ['all', 'admin'])
                    && (request.resource.data.get('title', '') is string)
                    && (request.resource.data.get('title', '').size() < 200)
                    || isAdmin();

      // Recipient may only flip read flags
      allow update: if isSignedIn() && (
        ((resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('recipientId', '') == request.auth.uid) &&
         onlyChanged(['isRead', 'read', 'readAt'])) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // SERVICE REQUESTS (Mobile & unified marketplace)
    // ------------------------------------------------------------------
    match /requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('providerId', '') == request.auth.uid ||
        resource.data.get('status', '') in ['pending', 'open'] ||
        isAdmin()
      );

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.get('paymentStatus', 'unpaid') == 'unpaid';

      allow update: if canUpdateJob(resource.data);

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // JOB REQUESTS (Web + shared)
    // ------------------------------------------------------------------
    match /job_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.get('clientId', '') == request.auth.uid ||
        resource.data.get('providerId', '') == request.auth.uid ||
        resource.data.get('status', '') in ['pending', 'open'] ||
        (resource.data.get('invitedProviderIds', []) is list &&
         resource.data.get('invitedProviderIds', []).hasAny([request.auth.uid])) ||
        isAdmin()
      );

      allow create: if isSignedIn()
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.get('paymentStatus', 'unpaid') == 'unpaid';

      allow update: if canUpdateJob(resource.data);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isSignedIn() && (
          get(/databases/$(database)/documents/job_requests/$(requestId)).data.get('clientId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/job_requests/$(requestId)).data.get('providerId', '') == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ------------------------------------------------------------------
    // PROPERTIES (Real estate listings)
    // ------------------------------------------------------------------
    match /properties/{propertyId} {
      allow read: if true;

      // Only agents/admins may list properties
      allow create: if isSignedIn() && (isAdmin() || userRole() == 'agent');

      // Only the owning agent or an admin can edit/delete, and ownership can't be transferred
      allow update: if isSignedIn() && (
        isAdmin() ||
        ((resource.data.get('agentId', '') == request.auth.uid ||
          resource.data.get('userId', '') == request.auth.uid) &&
         noneChanged(['agentId', 'userId']))
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.get('agentId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
    }

    // ------------------------------------------------------------------
    // TRANSACTIONS & ESCROW AUDIT
    // Escrow lifecycle is managed exclusively server-side via Cloud Functions
    // and verified Paystack HMAC-SHA512 webhooks. Clients have strictly
    // READ-ONLY access to their own transactions.
    // ------------------------------------------------------------------
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );

      // Clients CANNOT create or update transactions directly.
      // Cloud Functions (Admin SDK) and Admin panel handle all mutations.
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // USERS
    // ------------------------------------------------------------------
    match /users/{userId} {
      // Own profile, admins, or provider profiles (needed for marketplace)
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        resource.data.get('role', '') == 'service_provider'
      );

      // Create: own profile only; cannot grant admin or self-approve, cannot forge emailVerified
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.get('role', '') != 'admin'
                    && request.resource.data.get('status', '') != 'approved'
                    && request.resource.data.get('emailVerified', false) != true;

      // Update: own profile only. Cannot become admin, cannot self-approve,
      // cannot change role once approved, and cannot touch admin-managed or verification fields.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('role', '') != 'admin'
        && (request.resource.data.get('status', '') != 'approved' || resource.data.get('status', '') == 'approved')
        && (resource.data.get('status', '') != 'approved' || request.resource.data.get('role', '') == resource.data.get('role', ''))
        && noneChanged([
          'isAdmin', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectionReason',
          'suspended', 'isSuspended', 'rating', 'reviewCount', 'walletBalance', 'earnings',
          'emailVerified', 'verificationOtp'
        ])
      );

      allow delete: if isAdmin();

      // Sensitive identity & KYC documents: owner or admin only
      match /documents/{docId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      // Private authentication and OTP secrets: strictly inaccessible to ANY client SDK
      match /private_auth/{docId} {
        allow read, write: if false;
      }
    }

    // ------------------------------------------------------------------
    // ADMINS COLLECTION
    // ------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // APP CONFIG & VERSIONING (Mobile APK & Web releases)
    // ------------------------------------------------------------------
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
