rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isParticipant(userIds) {
      return isSignedIn() && (request.auth.uid in userIds);
    }
    
    // Check if user is an admin 
    // Checks admins collection, users collection (role == 'admin'), or designated admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email in ['admin@wheelhomes.com', 'admin@wheelofcomfort.com']
      );
    }
    
    // Basic PII Check (Best effort regex-like patterns)
    // Firestore rules don't support full Regex, so we check for common indicators
    // This is NOT perfect, client-side validation is the primary UX barrier.
    function hasPII(text) {
       // Check for '@' symbol as proxy for email
       return text.matches('.*@.*'); 
       // Note: Phone detection is too complex for robust Rules implementation without Regex
    }

    // --- CHATS COLLECTION ---
    match /chats/{chatId} {
      // Read: Participants or Admins
      allow read: if isParticipant(resource.data.participants) || isAdmin();
      
      // Create: user must include themselves in participants
      allow create: if isSignedIn() 
                    && request.resource.data.participants.hasAll([request.auth.uid])
                    && request.resource.data.keys().hasAll(['participants', 'createdAt', 'updatedAt']);

      // Update: Participants can update (e.g., lastMessage)
      allow update: if isParticipant(resource.data.participants);

      // --- MESSAGES SUBCOLLECTION ---
      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data.participants) || isAdmin();
        
        allow create: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text.size() < 2000
                      // Optional: Enforce PII check on server side too
                      // && !hasPII(request.resource.data.text) 
                      ;
      }
    }
    
    // --- USER APPLICATIONS (For existing Admin Panel) ---
    match /user_applications/{appId} {
        // Only admins can read/write full applications
        allow read, write: if isAdmin();
        // Users can create their own application (if we had a user-side flow, mostly open for now or restricted)
        allow create: if true; 
    }
    
    // --- NOTIFICATIONS ---
    match /notifications/{notificationId} {
      // Allow users to read their own notifications (supports both userId and recipientId)
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid || 
        resource.data.recipientId == 'admin' ||
        resource.data.recipientId == 'all' ||
        isAdmin()
      );
      
      // Allow users to create notifications
      allow create: if isSignedIn();

      // Allow users to update their own notification (mark as read)
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
    }
    
    // --- SERVICE REQUESTS (Mobile & Unified Marketplace) ---
    match /requests/{requestId} {
      // Read: Client, Assigned Provider, Pending marketplace, or Admin
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.providerId == request.auth.uid || 
        resource.data.status == 'pending' ||
        isAdmin()
      );

      // Create: User must be creator
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Update: Client, Assigned Provider, Provider claiming job, or Admin
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.providerId == request.auth.uid ||
        resource.data.status == 'pending' ||
        isAdmin()
      );
    }

    // --- JOB REQUESTS (Web compatibility) ---
    match /job_requests/{requestId} {
      // Read: 
      // 1. Owner (Client)
      // 2. Assigned Provider
      // 3. Pending requests (Marketplace - open to all auth users)
      // 4. Admins
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.providerId == request.auth.uid || 
        resource.data.status == 'pending' ||
        (resource.data.invitedProviderIds is list && request.auth.uid in resource.data.invitedProviderIds) ||
        isAdmin()
      );

      // Create: user must match clientId
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;

      // Update: Participants or Admin
      allow update: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );

      // --- MESSAGES SUBCOLLECTION (For UnifiedChat) ---
      match /messages/{messageId} {
         allow read, create: if isSignedIn() && (
           get(/databases/$(database)/documents/job_requests/$(requestId)).data.clientId == request.auth.uid ||
           get(/databases/$(database)/documents/job_requests/$(requestId)).data.providerId == request.auth.uid ||
           isAdmin()
         );
      }
    }

    // --- PROPERTIES (Real Estate Listings) ---
    match /properties/{propertyId} {
      // Public / All authenticated users can view active property listings
      allow read: if true;

      // Only signed-in users (agents/admins) can list properties
      allow create: if isSignedIn();

      // Only agent creator or admin can edit/update listings
      allow update, delete: if isSignedIn() && (
        resource.data.agentId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // --- TRANSACTIONS & ESCROW AUDIT ---
    match /transactions/{transactionId} {
      // Users can only view their own transactions; Admins can audit all
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // Authenticated users can record transactions associated with their own UID
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Updates (e.g. escrow status release) restricted to participants or admins
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // --- USERS ---
    match /users/{userId} {
      // Users can read/write their own data
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
      
      // Allow anyone to READ service provider profiles (needed for "Select Provider" list)
      allow read: if isSignedIn() && resource.data.role == 'service_provider';

      // Allow access to subcollections (e.g. documents)
      match /documents/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }

    // --- ADMINS COLLECTION ---
    match /admins/{adminId} {
        allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
        allow write: if isAdmin();
    }
  }
}
