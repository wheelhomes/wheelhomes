rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Verify file properties
    function validImageOrPdf() {
      return request.resource.contentType != null
          && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
    
    function validSize() {
      return request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // Admin = claim, admins/{uid} doc, users role, or (TEMPORARY) legacy admin email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin') ||
        request.auth.token.get('email', '') in ['admin@wheelhomes.com', 'admin@wheelofcomfort.com']
      );
    }

    // --- CHAT ATTACHMENTS ---
    // Path: chat-attachments/{chatId}/{fileName}
    match /chat-attachments/{chatId}/{allPaths=**} {
      
      // We need to look up the chat document to verify participants.
      // NOTE: Storage Rules -> Firestore lookup is allowed but costs a read.
      
      function isParticipant() {
         return firestore.exists(/databases/(default)/documents/chats/$(chatId)) 
                && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
      }

      allow read: if isSignedIn() && isParticipant();
      
      allow write: if isSignedIn() 
                   && isParticipant()
                   && validImageOrPdf()
                   && validSize();
    }

    // --- SERVICE REQUEST EVIDENCE & PHOTOS ---
    // Path: service_requests/{requestId}/{fileName}
    match /service_requests/{requestId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() 
                   && validImageOrPdf()
                   && validSize();
    }

    // --- PROPERTY PORTFOLIO PHOTOS ---
    // Path: properties/{propertyId}/{fileName}
    match /properties/{propertyId}/{allPaths=**} {
      // Public read so prospective clients can view property images
      allow read: if true;
      allow write: if isSignedIn() 
                   && validImageOrPdf()
                   && validSize();
    }

    // --- JOB EVIDENCE ---
    match /job_evidence/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && validImageOrPdf()
                   && validSize();
    }

    // --- PROVIDER DOCUMENTS ---
    // Identity verification docs (Gov ID, Passport)
    match /provider_docs/{userId}/{allPaths=**} {
       // Identity documents are strictly private: owner or admin only
       allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
       allow write: if isSignedIn() 
                    && request.auth.uid == userId
                    && validImageOrPdf()
                    && validSize();
    }
  }
}
